# Lift Prayer Network - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# Firebase Configuration
# Get these from Firebase Console > Project Settings > Your Apps > Config
# =============================================================================
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# =============================================================================
# Sentry Error Tracking (Optional)
# Get this from Sentry > Project Settings > Client Keys (DSN)
# =============================================================================
EXPO_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# =============================================================================
# Additional Configuration (Optional)
# =============================================================================
# EXPO_PUBLIC_APP_ENV=development
