build
tmp

# Environment files (contain secrets)
.env
.env.local
.env.development
.env.production

# Keep .env.example for reference (it has no real values)
!.env.example

# Firebase & Google service files (contain client-side API keys)
# Note: google-services.json and GoogleService-Info.plist are NOT ignored
# so EAS native builds can include the Firebase app config.
# These files contain client-side Firebase config (safe for private repos).
# google-services.json
# google-services*.json
# GoogleService-Info.plist
client_secret_*.json

# Service account and credentials (NEVER commit these)
service-account.json
service-account*.json
credentials.json

# Local secrets folder
secrets/

# Certificates & keystores
*.p12
*.keystore
*.jks
*.mobileprovision

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated native code (EAS Build regenerates these automatically)
android/
ios/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
