rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && request.auth.uid == data.ownerUid;
    }
    
    // Admin check - add admin UIDs here for elevated permissions
    // Admin email: fanelesibonge50@gmail.com
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'fanelesibonge50@gmail.com'
      );
    }
    
    function isMember(data) {
      return isSignedIn() && data.memberUids != null && data.memberUids.hasAny([request.auth.uid]);
    }
    
    // Validate request privacy flags are consistent
    // - GROUP visibility requires non-empty groupIds
    // - PRIVATE visibility should have isPrivate true
    // - PUBLIC visibility should not have isPrivate true
    function isValidRequestPrivacy(data) {
      let visibility = data.visibility;
      let isPrivate = data.isPrivate;
      let groupIds = data.groupIds;
      
      // GROUP requests must have at least one groupId
      let groupValid = visibility != 'GROUP' || (groupIds != null && groupIds.size() > 0);
      
      // PRIVATE requests should have isPrivate flag set
      let privateValid = visibility != 'PRIVATE' || isPrivate == true;
      
      // PUBLIC requests should not be marked private
      let publicValid = visibility != 'PUBLIC' || isPrivate != true;
      
      return groupValid && privateValid && publicValid;
    }

    match /users/{uid} {
      // Only allow reading certain fields publicly, full profile to self
      // Admins can read any user for moderation
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Users can write to their own profile
      // Admins can update ban status on any user
      allow write: if isSignedIn() && (
        request.auth.uid == uid || 
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isBanned', 'bannedAt', 'banReason', 'unbannedAt']))
      );
    }

    match /requests/{requestId} {
      // Requests are publicly readable for backward compatibility and smooth queries
      // Privacy filtering (PRIVATE, GROUP visibility) happens client-side
      // This avoids query permission errors when listing the main feed
      allow read: if true;
      // Create requires: signed in, owns the request, and privacy flags are consistent
      allow create: if isSignedIn() 
        && request.resource.data.ownerUid == request.auth.uid
        && isValidRequestPrivacy(request.resource.data);
      // Update rules:
      // 1. Owner can update their own content
      // 2. Admin can update anything including pins
      // 3. Any signed-in user can increment prayer count (for praying functionality)
      // 4. Any signed-in user can update reaction counts
      allow update: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || 
        isAdmin() ||
        // Allow any user to update ONLY prayer-related and reaction fields
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['prayers', 'status', 'severity', 'activatedAt', 'heartCount', 'fireCount', 'strongCount'])
      );
      // Allow owner OR admin to delete - simplified check
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /testimonies/{testimonyId} {
      // Testimonies are publicly readable for backward compatibility
      // Privacy filtering happens client-side for a smooth UX
      // New testimonies with visibility: PRIVATE or GROUP will be filtered by client
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // Allow owner OR admin to update - simplified check
      // Also allow any signed-in user to update reaction counts
      allow update: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || 
        isAdmin() ||
        // Allow any user to update ONLY likes and reaction fields
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'heartCount', 'fireCount', 'strongCount'])
      );
      // Allow owner OR admin to delete - simplified check
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Reactions collection - tracks individual user reactions to prevent duplicates
    match /reactions/{reactionId} {
      // Allow any signed-in user to read reactions (needed for toggle check in transactions)
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.actorUid == request.auth.uid;
    }

    match /prayers/{prayerId} {
      // Allow reading prayers where user is actor or target owner (for history and notifications)
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.actorUid || 
        request.auth.uid == resource.data.targetOwnerUid
      );
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      // Allow users to delete their own prayer records (for delete prayer history feature)
      allow delete: if isSignedIn() && request.auth.uid == resource.data.actorUid;
    }

    match /userPrayedFor/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      allow read: if !resource.data.isPrivate || isMember(resource.data) || isOwner(resource.data);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;

      // Owner can manage everything including membership
      // Members can only adjust basic metadata (no membership changes)
      // Non-members can:
      //   - Join public groups (add themselves to memberUids)
      //   - Request to join private groups (add themselves to pendingRequests)
      allow update: if isOwner(resource.data)
        || (
          // Members can update metadata only
          isMember(resource.data)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['name', 'description', 'emoji'])
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.isPrivate == resource.data.isPrivate
        )
        || (
          // Non-members can join PUBLIC groups (add only themselves to memberUids)
          isSignedIn()
          && !resource.data.isPrivate
          && !isMember(resource.data)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAny([request.auth.uid])
        )
        || (
          // Non-members can request to join PRIVATE groups (add only themselves to pendingRequests)
          isSignedIn()
          && resource.data.isPrivate
          && !isMember(resource.data)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['pendingRequests'])
          && (resource.data.pendingRequests == null || request.resource.data.pendingRequests.hasAll(resource.data.pendingRequests))
          && request.resource.data.pendingRequests.hasAny([request.auth.uid])
        );

      allow delete: if isOwner(resource.data);
    }

    match /comments/{commentId} {
      // Comments are publicly readable for consistency with requests/testimonies
      // Privacy filtering happens client-side
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      // Allow comment owner OR admin to update/delete
      // Owner can only update content and editedAt, not change parentId, authorUid, or parentType
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == resource.data.authorUid
          && request.resource.data.parentId == resource.data.parentId
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.parentType == resource.data.parentType
        )
      );
      allow delete: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.authorUid);
    }

    match /reports/{reportId} {
      // Require authentication and matching actor
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      // Only admins can read reports for moderation
      allow read: if isAdmin();
      // Admins can update reports (mark as reviewed, resolved, etc.)
      allow update: if isAdmin();
      // Allow admins to delete any report and reporters to delete their own
      allow delete: if isAdmin() || (isSignedIn() && resource.data.actorUid == request.auth.uid);
    }

    match /stats/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid}/pushTokens/{token} {
      allow write, read: if isSignedIn() && request.auth.uid == uid;
    }

    // Onboarding analytics - anyone can write (anonymous users complete onboarding)
    // Only admins can read for analysis
    match /onboarding_analytics/{docId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Notifications - users can read/update their own notifications
    // Create is restricted to ensure actorUid matches the authenticated user (prevents spoofing)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      // Only allow creating notifications where the actor is the authenticated user
      // This prevents users from creating fake notifications impersonating others
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
    }

    // Announcements - admin-only creation/editing, readable by all signed-in users
    match /announcements/{announcementId} {
      // All signed-in users can read announcements
      allow read: if isSignedIn();
      // Only admins can create, update, and delete announcements
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Devotions - admin-only creation/editing, readable by all signed-in users
    match /devotions/{devotionId} {
      // All signed-in users can read devotions
      allow read: if isSignedIn();
      // Only admins can create, update, and delete devotions
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Following - users can manage their own following list
    match /following/{uid}/users/{targetUid} {
      // Users can read their own following list
      allow read: if isSignedIn() && request.auth.uid == uid;
      // Users can follow/unfollow (create/delete) in their own list
      allow create: if isSignedIn() && request.auth.uid == uid 
        && request.resource.data.targetUid == targetUid;
      allow delete: if isSignedIn() && request.auth.uid == uid;
      // No updates needed - just create/delete
      allow update: if false;
    }
  }
}
